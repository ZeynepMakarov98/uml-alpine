name: t4a
on:
  push:
    branches: [main]
jobs:
  uml:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Assemble Alpine initramfs
        run: |
          AVER=$(curl -fsSL https://dl-cdn.alpinelinux.org/alpine/latest-stable/releases/x86_64/ \
                | grep -oP 'alpine-minirootfs-\K[0-9.]+(?=-x86_64\.tar\.gz)' | head -1)
          echo "AVER=$AVER" >> "$GITHUB_ENV"
          mkdir -p rootfs
          curl -fsSL "https://dl-cdn.alpinelinux.org/alpine/latest-stable/releases/x86_64/alpine-minirootfs-$AVER-x86_64.tar.gz" \
            | tar -xz -C rootfs
          mkdir -p rootfs/proc rootfs/sys rootfs/dev
          printf '#!/bin/sh\nmount -t proc none /proc\nmount -t sysfs none /sys\nmount -t devtmpfs none /dev 2>/dev/null\n' > rootfs/init
          echo 'echo UML-OK' >> rootfs/init
          chmod +x rootfs/init
          echo "initramfs: $(du -sh rootfs | cut -f1)"

